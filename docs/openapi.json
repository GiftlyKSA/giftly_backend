{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "RefreshRequest": {
        "additionalProperties": false,
        "description": "Exchange a refresh token for a new token pair.",
        "properties": {
          "refresh_token": {
            "description": "The current refresh token.",
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "RefreshRequest",
        "type": "object"
      },
      "RegisterRequest": {
        "additionalProperties": false,
        "description": "Create an account authorised by a registration token.",
        "properties": {
          "city": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Required for couriers.",
            "title": "City"
          },
          "dob": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dob"
          },
          "email": {
            "anyOf": [
              {
                "maxLength": 255,
                "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "full_name": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Full Name"
          },
          "national_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Courier identity (national id or passport required).",
            "title": "National Id"
          },
          "passport_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Passport Id"
          },
          "registration_token": {
            "description": "From verify-otp when is_new_user is true.",
            "title": "Registration Token",
            "type": "string"
          },
          "role": {
            "description": "The account role to create.",
            "enum": [
              "CUSTOMER",
              "COURIER"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "registration_token",
          "role"
        ],
        "title": "RegisterRequest",
        "type": "object"
      },
      "SendOtpRequest": {
        "additionalProperties": false,
        "description": "Request an OTP for a phone number.",
        "properties": {
          "phone": {
            "description": "Saudi E.164 mobile.",
            "examples": [
              "+966501234567"
            ],
            "pattern": "^\\+9665\\d{8}$",
            "title": "Phone",
            "type": "string"
          }
        },
        "required": [
          "phone"
        ],
        "title": "SendOtpRequest",
        "type": "object"
      },
      "SendOtpResponse": {
        "description": "OTP request accepted.",
        "properties": {
          "dev_otp": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The OTP, returned only in development to ease local testing.",
            "title": "Dev Otp"
          },
          "expires_in": {
            "description": "Seconds until the OTP expires.",
            "examples": [
              180
            ],
            "title": "Expires In",
            "type": "integer"
          }
        },
        "required": [
          "expires_in"
        ],
        "title": "SendOtpResponse",
        "type": "object"
      },
      "TokenResponse": {
        "description": "An issued access + refresh token pair.",
        "properties": {
          "access_token": {
            "description": "30-minute access JWT.",
            "title": "Access Token",
            "type": "string"
          },
          "refresh_token": {
            "description": "30-day rotating refresh token.",
            "title": "Refresh Token",
            "type": "string"
          },
          "role": {
            "description": "The authenticated user's role.",
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "refresh_token",
          "role"
        ],
        "title": "TokenResponse",
        "type": "object"
      },
      "UserMeResponse": {
        "description": "The authenticated user's own profile.",
        "properties": {
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Email, used only for the paid receipt.",
            "title": "Email"
          },
          "full_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Display name.",
            "title": "Full Name"
          },
          "id": {
            "description": "User id.",
            "title": "Id",
            "type": "string"
          },
          "phone": {
            "description": "E.164 phone.",
            "title": "Phone",
            "type": "string"
          },
          "rating": {
            "description": "Denormalized average rating as a decimal string.",
            "title": "Rating",
            "type": "string"
          },
          "rating_count": {
            "description": "Number of ratings received.",
            "title": "Rating Count",
            "type": "integer"
          },
          "role": {
            "description": "User role.",
            "title": "Role",
            "type": "string"
          },
          "status": {
            "description": "Account status.",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "phone",
          "role",
          "status",
          "rating",
          "rating_count"
        ],
        "title": "UserMeResponse",
        "type": "object"
      },
      "UserUpdateRequest": {
        "additionalProperties": false,
        "description": "Editable profile fields.",
        "properties": {
          "dob": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dob"
          },
          "email": {
            "anyOf": [
              {
                "maxLength": 255,
                "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "full_name": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Full Name"
          }
        },
        "title": "UserUpdateRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VerifyOtpRequest": {
        "additionalProperties": false,
        "description": "Verify a submitted OTP.",
        "properties": {
          "otp": {
            "description": "The 6-digit code.",
            "examples": [
              "849201"
            ],
            "pattern": "^\\d{6}$",
            "title": "Otp",
            "type": "string"
          },
          "phone": {
            "description": "Saudi E.164 mobile.",
            "pattern": "^\\+9665\\d{8}$",
            "title": "Phone",
            "type": "string"
          }
        },
        "required": [
          "phone",
          "otp"
        ],
        "title": "VerifyOtpRequest",
        "type": "object"
      },
      "VerifyOtpResponse": {
        "description": "The result of verifying an OTP: tokens for an existing user, else a handoff.",
        "properties": {
          "access_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "30-minute access JWT, if existing user.",
            "title": "Access Token"
          },
          "is_new_user": {
            "description": "True when no account exists for the phone.",
            "title": "Is New User",
            "type": "boolean"
          },
          "refresh_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "30-day refresh token, if existing user.",
            "title": "Refresh Token"
          },
          "registration_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Short-lived token to call /api/auth/register, if a new user.",
            "title": "Registration Token"
          },
          "role": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The user's role, when tokens are issued.",
            "title": "Role"
          }
        },
        "required": [
          "is_new_user"
        ],
        "title": "VerifyOtpResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "SAFE-GIFT API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/logout": {
      "post": {
        "description": "Denylist the caller's access token until it would have expired.",
        "operationId": "logout_api_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/refresh": {
      "post": {
        "description": "Rotate a refresh token, returning a new pair (reuse revokes the family).",
        "operationId": "refresh_api_auth_refresh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Refresh",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/register": {
      "post": {
        "description": "Create the account authorised by a registration token and return tokens.",
        "operationId": "register_api_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Register",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/send-otp": {
      "post": {
        "description": "Send a login OTP. The response is identical whether or not the phone exists.",
        "operationId": "send_otp_api_auth_send_otp_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendOtpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendOtpResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Send Otp",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/verify-otp": {
      "post": {
        "description": "Verify an OTP, returning tokens for an existing user or a registration token.",
        "operationId": "verify_otp_api_auth_verify_otp_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyOtpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyOtpResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Verify Otp",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/dev/ping": {
      "get": {
        "description": "Confirm dev routes are registered (development only).",
        "operationId": "dev_ping_api_dev_ping_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Dev Ping Api Dev Ping Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Development liveness marker",
        "tags": [
          "dev"
        ]
      }
    },
    "/api/health": {
      "get": {
        "description": "Return a static liveness marker with no dependency checks.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Api Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/api/health/ready": {
      "get": {
        "description": "Return readiness. Dependency checks are wired in as services are added.\n\nNote:\n    Kept dependency-free until the DB/Redis/S3 sessions land so the skeleton is\n    runnable; the readiness checks are a Phase 2+ concern.",
        "operationId": "ready_api_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Ready Api Health Ready Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/api/users/me": {
      "get": {
        "description": "Return the authenticated user's own profile.",
        "operationId": "get_me_api_users_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserMeResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Me",
        "tags": [
          "users"
        ]
      },
      "patch": {
        "description": "Update the authenticated user's editable profile fields.",
        "operationId": "update_me_api_users_me_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserMeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Update Me",
        "tags": [
          "users"
        ]
      }
    }
  }
}
