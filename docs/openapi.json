{
  "components": {
    "schemas": {
      "CancelOrderRequest": {
        "additionalProperties": false,
        "description": "Cancel an order before it is in progress.",
        "properties": {
          "reason": {
            "anyOf": [
              {
                "maxLength": 255,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "title": "CancelOrderRequest",
        "type": "object"
      },
      "ConfirmRequest": {
        "additionalProperties": false,
        "description": "Confirm that an object was uploaded to a key.",
        "properties": {
          "storage_key": {
            "description": "The key returned by upload-urls.",
            "title": "Storage Key",
            "type": "string"
          }
        },
        "required": [
          "storage_key"
        ],
        "title": "ConfirmRequest",
        "type": "object"
      },
      "ConfirmResponse": {
        "description": "Confirmation that an upload passed validation.",
        "properties": {
          "confirmed": {
            "description": "True when the object is valid.",
            "title": "Confirmed",
            "type": "boolean"
          },
          "storage_key": {
            "description": "The confirmed key.",
            "title": "Storage Key",
            "type": "string"
          }
        },
        "required": [
          "storage_key",
          "confirmed"
        ],
        "title": "ConfirmResponse",
        "type": "object"
      },
      "CreateOrderRequest": {
        "additionalProperties": false,
        "description": "Create a gift-request order.",
        "properties": {
          "delivery_city": {
            "maxLength": 100,
            "title": "Delivery City",
            "type": "string"
          },
          "delivery_date": {
            "description": "Requested delivery date (<= 6 months out).",
            "format": "date",
            "title": "Delivery Date",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "latitude": {
            "description": "Drop-off latitude.",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude",
            "type": "number"
          },
          "longitude": {
            "description": "Drop-off longitude.",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude",
            "type": "number"
          },
          "request_media_keys": {
            "description": "Confirmed request-photo keys (0\u20133).",
            "items": {
              "type": "string"
            },
            "maxItems": 3,
            "title": "Request Media Keys",
            "type": "array"
          }
        },
        "required": [
          "delivery_city",
          "latitude",
          "longitude",
          "delivery_date"
        ],
        "title": "CreateOrderRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "OrderDetail": {
        "description": "A full order view for its participants.",
        "properties": {
          "assigned_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assigned At"
          },
          "courier_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Courier Id"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "customer_id": {
            "title": "Customer Id",
            "type": "string"
          },
          "delivery_city": {
            "title": "Delivery City",
            "type": "string"
          },
          "delivery_date": {
            "title": "Delivery Date",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "latitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Shown to a courier only once assigned.",
            "title": "Latitude"
          },
          "longitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Longitude"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "total_amount": {
            "title": "Total Amount",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "customer_id",
          "courier_id",
          "delivery_city",
          "delivery_date",
          "description",
          "total_amount",
          "assigned_at",
          "created_at"
        ],
        "title": "OrderDetail",
        "type": "object"
      },
      "OrderListResponse": {
        "description": "A keyset page of order summaries.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderSummary"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items"
        ],
        "title": "OrderListResponse",
        "type": "object"
      },
      "OrderSummary": {
        "description": "A compact order row for lists and the radar (no exact coordinates).",
        "properties": {
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "delivery_city": {
            "title": "Delivery City",
            "type": "string"
          },
          "delivery_date": {
            "title": "Delivery Date",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "delivery_city",
          "delivery_date",
          "description",
          "created_at"
        ],
        "title": "OrderSummary",
        "type": "object"
      },
      "RefreshRequest": {
        "additionalProperties": false,
        "description": "Exchange a refresh token for a new token pair.",
        "properties": {
          "refresh_token": {
            "description": "The current refresh token.",
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "RefreshRequest",
        "type": "object"
      },
      "RegisterRequest": {
        "additionalProperties": false,
        "description": "Create an account authorised by a registration token.",
        "properties": {
          "city": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Required for couriers.",
            "title": "City"
          },
          "dob": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dob"
          },
          "email": {
            "anyOf": [
              {
                "maxLength": 255,
                "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "full_name": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Full Name"
          },
          "national_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Courier identity (national id or passport required).",
            "title": "National Id"
          },
          "passport_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Passport Id"
          },
          "registration_token": {
            "description": "From verify-otp when is_new_user is true.",
            "title": "Registration Token",
            "type": "string"
          },
          "role": {
            "description": "The account role to create.",
            "enum": [
              "CUSTOMER",
              "COURIER"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "registration_token",
          "role"
        ],
        "title": "RegisterRequest",
        "type": "object"
      },
      "SendOtpRequest": {
        "additionalProperties": false,
        "description": "Request an OTP for a phone number.",
        "properties": {
          "phone": {
            "description": "Saudi E.164 mobile.",
            "examples": [
              "+966501234567"
            ],
            "pattern": "^\\+9665\\d{8}$",
            "title": "Phone",
            "type": "string"
          }
        },
        "required": [
          "phone"
        ],
        "title": "SendOtpRequest",
        "type": "object"
      },
      "SendOtpResponse": {
        "description": "OTP request accepted.",
        "properties": {
          "dev_otp": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The OTP, returned only in development to ease local testing.",
            "title": "Dev Otp"
          },
          "expires_in": {
            "description": "Seconds until the OTP expires.",
            "examples": [
              180
            ],
            "title": "Expires In",
            "type": "integer"
          }
        },
        "required": [
          "expires_in"
        ],
        "title": "SendOtpResponse",
        "type": "object"
      },
      "TokenResponse": {
        "description": "An issued access + refresh token pair.",
        "properties": {
          "access_token": {
            "description": "30-minute access JWT.",
            "title": "Access Token",
            "type": "string"
          },
          "refresh_token": {
            "description": "30-day rotating refresh token.",
            "title": "Refresh Token",
            "type": "string"
          },
          "role": {
            "description": "The authenticated user's role.",
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "refresh_token",
          "role"
        ],
        "title": "TokenResponse",
        "type": "object"
      },
      "TransactionPage": {
        "description": "A keyset page of transactions.",
        "properties": {
          "items": {
            "description": "Newest first.",
            "items": {
              "$ref": "#/components/schemas/TransactionResponse"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Pass back to fetch the next page.",
            "title": "Next Cursor"
          }
        },
        "required": [
          "items"
        ],
        "title": "TransactionPage",
        "type": "object"
      },
      "TransactionResponse": {
        "description": "One ledger entry as seen by its wallet owner.",
        "properties": {
          "amount": {
            "description": "Signed amount as a decimal string.",
            "title": "Amount",
            "type": "string"
          },
          "balance_after": {
            "description": "Wallet balance after this entry.",
            "title": "Balance After",
            "type": "string"
          },
          "created_at": {
            "description": "ISO-8601 UTC timestamp.",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "description": "Transaction id.",
            "title": "Id",
            "type": "string"
          },
          "status": {
            "description": "PENDING | SETTLED | REVERSED.",
            "title": "Status",
            "type": "string"
          },
          "type": {
            "description": "Transaction type.",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "amount",
          "type",
          "status",
          "balance_after",
          "created_at"
        ],
        "title": "TransactionResponse",
        "type": "object"
      },
      "UploadUrlRequest": {
        "additionalProperties": false,
        "description": "Request a pre-signed upload URL for a media object.",
        "properties": {
          "byte_size": {
            "description": "Declared size in bytes; must be within the cap.",
            "exclusiveMinimum": 0.0,
            "title": "Byte Size",
            "type": "integer"
          },
          "content_type": {
            "description": "The image MIME type; pinned into the pre-signed URL.",
            "enum": [
              "image/jpeg",
              "image/png"
            ],
            "title": "Content Type",
            "type": "string"
          },
          "purpose": {
            "description": "What the media is for; determines the key prefix.",
            "enum": [
              "ORDER_REQUEST",
              "DELIVERY_PROOF"
            ],
            "title": "Purpose",
            "type": "string"
          }
        },
        "required": [
          "purpose",
          "content_type",
          "byte_size"
        ],
        "title": "UploadUrlRequest",
        "type": "object"
      },
      "UploadUrlResponse": {
        "description": "A pre-signed upload URL and the server-generated key.",
        "properties": {
          "expires_in": {
            "description": "Seconds the URL is valid.",
            "title": "Expires In",
            "type": "integer"
          },
          "storage_key": {
            "description": "Confirm this key after uploading.",
            "title": "Storage Key",
            "type": "string"
          },
          "upload_url": {
            "description": "PUT the bytes here directly (never via the API).",
            "title": "Upload Url",
            "type": "string"
          }
        },
        "required": [
          "upload_url",
          "storage_key",
          "expires_in"
        ],
        "title": "UploadUrlResponse",
        "type": "object"
      },
      "UserMeResponse": {
        "description": "The authenticated user's own profile.",
        "properties": {
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Email, used only for the paid receipt.",
            "title": "Email"
          },
          "full_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Display name.",
            "title": "Full Name"
          },
          "id": {
            "description": "User id.",
            "title": "Id",
            "type": "string"
          },
          "phone": {
            "description": "E.164 phone.",
            "title": "Phone",
            "type": "string"
          },
          "rating": {
            "description": "Denormalized average rating as a decimal string.",
            "title": "Rating",
            "type": "string"
          },
          "rating_count": {
            "description": "Number of ratings received.",
            "title": "Rating Count",
            "type": "integer"
          },
          "role": {
            "description": "User role.",
            "title": "Role",
            "type": "string"
          },
          "status": {
            "description": "Account status.",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "phone",
          "role",
          "status",
          "rating",
          "rating_count"
        ],
        "title": "UserMeResponse",
        "type": "object"
      },
      "UserUpdateRequest": {
        "additionalProperties": false,
        "description": "Editable profile fields.",
        "properties": {
          "dob": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dob"
          },
          "email": {
            "anyOf": [
              {
                "maxLength": 255,
                "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "full_name": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Full Name"
          }
        },
        "title": "UserUpdateRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VerifyOtpRequest": {
        "additionalProperties": false,
        "description": "Verify a submitted OTP.",
        "properties": {
          "otp": {
            "description": "The 6-digit code.",
            "examples": [
              "849201"
            ],
            "pattern": "^\\d{6}$",
            "title": "Otp",
            "type": "string"
          },
          "phone": {
            "description": "Saudi E.164 mobile.",
            "pattern": "^\\+9665\\d{8}$",
            "title": "Phone",
            "type": "string"
          }
        },
        "required": [
          "phone",
          "otp"
        ],
        "title": "VerifyOtpRequest",
        "type": "object"
      },
      "VerifyOtpResponse": {
        "description": "The result of verifying an OTP: tokens for an existing user, else a handoff.",
        "properties": {
          "access_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "30-minute access JWT, if existing user.",
            "title": "Access Token"
          },
          "is_new_user": {
            "description": "True when no account exists for the phone.",
            "title": "Is New User",
            "type": "boolean"
          },
          "refresh_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "30-day refresh token, if existing user.",
            "title": "Refresh Token"
          },
          "registration_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Short-lived token to call /api/auth/register, if a new user.",
            "title": "Registration Token"
          },
          "role": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The user's role, when tokens are issued.",
            "title": "Role"
          }
        },
        "required": [
          "is_new_user"
        ],
        "title": "VerifyOtpResponse",
        "type": "object"
      },
      "WalletResponse": {
        "description": "A user's wallet snapshot.",
        "properties": {
          "available": {
            "description": "balance - held_balance.",
            "title": "Available",
            "type": "string"
          },
          "balance": {
            "description": "Total balance as a decimal string.",
            "examples": [
              "300.00"
            ],
            "title": "Balance",
            "type": "string"
          },
          "currency": {
            "description": "ISO currency code.",
            "examples": [
              "SAR"
            ],
            "title": "Currency",
            "type": "string"
          },
          "held_balance": {
            "description": "Funds held (e.g. an escrow hold).",
            "title": "Held Balance",
            "type": "string"
          }
        },
        "required": [
          "balance",
          "held_balance",
          "available",
          "currency"
        ],
        "title": "WalletResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "SAFE-GIFT API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/logout": {
      "post": {
        "description": "Denylist the caller's access token until it would have expired.",
        "operationId": "logout_api_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/refresh": {
      "post": {
        "description": "Rotate a refresh token, returning a new pair (reuse revokes the family).",
        "operationId": "refresh_api_auth_refresh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Refresh",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/register": {
      "post": {
        "description": "Create the account authorised by a registration token and return tokens.",
        "operationId": "register_api_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Register",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/send-otp": {
      "post": {
        "description": "Send a login OTP. The response is identical whether or not the phone exists.",
        "operationId": "send_otp_api_auth_send_otp_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendOtpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
