# SAFE-GIFT environment template. Copy to .env and fill in for local development.
# NEVER commit a real .env. NEVER put a real secret in this file.
# In deployment these reach the container at runtime (task definition / compose
# override / systemd EnvironmentFile) — never baked into the image.

# --- Environment (REQUIRED, no default) -------------------------------------
# One of: development | test | production
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Data --------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/safegift
REDIS_URL=redis://:changeme@localhost:6379/0

# --- Auth / JWT --------------------------------------------------------------
# HS256: provide a >= 32 byte secret. RS256 (preferred): provide the key pair instead.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=safe-gift
JWT_AUDIENCE=safe-gift
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

# --- Field encryption (env-var key management) -------------------------------
# JSON map of version -> base64 of a 32-byte key. Generate with:
#   python -c "import os,base64,json;print(json.dumps({'1':base64.b64encode(os.urandom(32)).decode()}))"
FIELD_ENCRYPTION_KEYS=
FIELD_ENCRYPTION_KEY_VERSION=1
# Must be >= 32 bytes AND different from every encryption key.
IDENTITY_FINGERPRINT_PEPPER=

# --- Storage / CDN (required in production) ----------------------------------
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=

# --- StreamPay (required only when ENVIRONMENT=production) --------------------
STREAMPAY_API_KEY=
STREAMPAY_API_SECRET=
STREAMPAY_WEBHOOK_SECRET=
# Optional client redirects after the hosted StreamPay checkout completes.
STREAMPAY_SUCCESS_REDIRECT_URL=
STREAMPAY_FAILURE_REDIRECT_URL=

# --- sndr.sh email (required only when ENVIRONMENT=production) ----------------
SNDR_API_KEY=
SNDR_BASE_URL=
SNDR_FROM_EMAIL=
SNDR_FROM_NAME=
SNDR_INVOICE_PAID_TEMPLATE_KEY=

# --- SMS / Push --------------------------------------------------------------
SMS_PROVIDER_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Admin dashboard ---------------------------------------------------------
# Development defaults only. Production rejects admin/admin and passwords under 12 chars.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_SESSION_SECRET=local-development-admin-session-secret-change-me
ADMIN_SESSION_TTL_MINUTES=60
ADMIN_DASHBOARD_ENABLED=true

# --- CORS (ignored in development; REQUIRED, non-wildcard in production) ------
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Business rules (safe defaults; override deliberately) -------------------
DEFAULT_VAT_RATE=0.15
SERVICE_FEE_RATE=0.05
SERVICE_FEE_MIN_AMOUNT=5.00
SERVICE_FEE_MAX_AMOUNT=500.00
PLATFORM_COMMISSION_RATE=0.10
MAX_INVOICE_ITEMS=20
MAX_INVOICE_AMOUNT=50000.00
MAX_ITEM_UNIT_PRICE=50000.00
MIN_TOPUP_AMOUNT=100.00
MAX_TOPUP_AMOUNT=20000.00
MIN_WITHDRAWAL_AMOUNT=50.00
MAX_DELIVERY_RADIUS_METERS=200
AUTO_APPROVE_HOURS=72
PAYMENT_EXPIRY_HOURS=48
MAX_UPLOAD_BYTES=10485760
OTP_TTL_SECONDS=180
OTP_MAX_PER_WINDOW=3
OTP_WINDOW_SECONDS=300
OTP_BLOCK_SECONDS=1800
# Optional dedicated OTP HMAC key (>= 32 random bytes). If unset the JWT secret is
# used, then the identity pepper — set this explicitly when running RS256.
OTP_HMAC_KEY=
REFRESH_TOKEN_RETENTION_DAYS=30

# --- Hardening (safe defaults; override deliberately) -------------------------
# Comma-separated proxy IPs/CIDRs whose X-Forwarded-* headers Uvicorn may trust.
# Never use "*" on a publicly reachable service.
FORWARDED_ALLOW_IPS=127.0.0.1,::1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=1048576
WS_RATE_LIMIT_MAX_MESSAGES=30
WS_RATE_LIMIT_WINDOW_SECONDS=60
WS_MAX_FRAME_BYTES=4096

# --- Local compose only ------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=safegift
REDIS_PASSWORD=changeme
